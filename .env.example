# =============================================================================
# .env.example - Шаблон конфігурації для PowerBot
# =============================================================================
# Скопіюйте цей файл як .env і заповніть реальними значеннями
# НІКОЛИ не комітьте .env з реальними токенами!
# =============================================================================

# Telegram Bot Token від @BotFather
BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"

# Username бота (без @)
BOT_USERNAME="YourBotUsername"

# Web App (Mini App)
WEB_APP=0
WEB_APP_URL="https://new-england.morgan-dev.com/app"
SINGLE_MESSAGE_MODE=0

# Runtime logging (persistent files in container volume)
LOG_LEVEL="INFO"
LOG_DIR="/data/logs"
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
# Optional: separate log for SQLite lock contention ("database is locked" retries).
# If not set, the app defaults to /data/logs/locks.log when DB_PATH is under /data (docker-compose).
SQLITE_LOCK_LOG_PATH="/data/logs/locks.log"

# Business mode (feature-flagged rollout)
# 0 = business features are hidden/disabled in main bot
# 1 = business features are enabled in main (resident) bot UI/logic
# Note: businessbot runtime is controlled separately: if BUSINESS_BOT_API_KEY is set and the
# docker-compose "business" profile is started, businessbot will run even when BUSINESS_MODE=0.
BUSINESS_MODE=0
# Telegram token for separate business bot (@BotFather)
BUSINESS_BOT_API_KEY=""
# Keep business-bot UI clean by editing one persistent inline-menu message
# and deleting user inputs (best-effort).
BUSINESS_BOT_SINGLE_MESSAGE_MODE=1
# Payment provider for business plans:
# - mock: test simulation (no real списання)
# - telegram_stars: real Telegram Stars flow
BUSINESS_PAYMENT_PROVIDER="telegram_stars"
# Test-only safety switch (used by scripts/deploy_test.sh):
# In /opt/powerbot-test the deploy script forces BUSINESS_PAYMENT_PROVIDER=mock unless you explicitly allow it.
# Set to 1 ONLY when you want to preview real Telegram Stars UI in test (it may списувати Stars).
BUSINESS_TEST_ALLOW_TELEGRAM_STARS=0

# Telegram API creds (shared for testerbot/adbot Telethon-based runners).
# Keep shared across environments, and use string sessions for test/prod bot automation.
TELETHON_API_ID="33083266"
TELETHON_API_HASH="87fe44a26a1a986054273f1d58ab7f3f"

# Admin bot (separate Telegram bot for control-plane/admin UI)
# If empty, adminbot service will not be started.
ADMIN_BOT_API_KEY=""
# Keep admin-bot UI clean by editing one persistent inline-menu message
# and deleting user inputs (best-effort).
ADMIN_BOT_SINGLE_MESSAGE_MODE=1
# Internal runtime selector (set automatically by docker-compose service)
# APP_ENTRYPOINT=main.py | business_main.py
#
# testerbot (test-only) runtime
TESTERBOT_ENABLED=0
TESTERBOT_STRING_SESSION="your-testerbot-string-session"
TESTERBOT_TARGET_POWERBOT_USERNAME="YourPowerbotUsername"
TESTERBOT_TARGET_ADMINBOT_USERNAME="YourAdminbotUsername"
TESTERBOT_TARGET_BUSINESSBOT_USERNAME="YourBusinessbotUsername"
TESTERBOT_ALLOWED_CHAT_IDS=
# Note: deploy_test auto-bootstraps target usernames and allowlist IDs from
# BOT_TOKEN/ADMIN_BOT_API_KEY/BUSINESS_BOT_API_KEY when placeholders are present.
# Optional explicit scenarios
TESTERBOT_TIMEOUT_SEC=25
TESTERBOT_REPORT_PATH="/data/logs/testerbot_report.json"
TESTERBOT_JUNIT_PATH="/data/logs/testerbot_report.xml"
TESTERBOT_BUILDING_LABEL="Ньюкасл (24-в)"
TESTERBOT_SECTION_LABEL="2 секція"
TESTERBOT_DB_PATH="/data/state.db"
TESTERBOT_IDEMPOTENCE_TABLES="business_owners,business_subscriptions,business_subscription_periods,business_payment_events,business_claim_tokens,place_reports,admin_jobs"

# adbot runtime
ADBOT_ENABLED=0
ADBOT_TEST_MODE=0
ADBOT_STRING_SESSION="your-adbot-string-session"
ADBOT_SOURCE_CHAT_IDS=
ADBOT_INTERNAL_CHAT_ID=
ADBOT_TARGET_POWERBOT_USERNAME="YourPowerbotUsername"
ADBOT_REPLY_COOLDOWN_SEC=10800
ADBOT_MIN_MESSAGE_LEN=14
ADBOT_MAX_MESSAGE_LEN=280
ADBOT_MIN_CONFIDENCE=120
ADBOT_PIPELINE_TIMEOUT_MS=5000
# Optional dedicated decision log for adbot match/no-match reasoning.
# If unset, uses LOG_DIR + ADBOT_DECISION_LOG_FILE_NAME.
ADBOT_DECISION_LOG_PATH=""
ADBOT_DECISION_LOG_FILE_NAME="adbot_decisions.log"
ADBOT_DECISION_LOG_MAX_BYTES=10485760
ADBOT_DECISION_LOG_BACKUP_COUNT=10
# Optional real Telegram E2E for adbot group flow (disabled by default).
ADBOT_E2E_ENABLED=0
ADBOT_E2E_DRIVER_STRING_SESSION="your-adbot-e2e-driver-string-session"
ADBOT_E2E_SOURCE_CHAT_ID=
ADBOT_E2E_INTERNAL_CHAT_ID=
ADBOT_E2E_TIMEOUT_SEC=45
ADBOT_E2E_POLL_SEC=1.0
ADBOT_E2E_NEGATIVE_WAIT_SEC=12
ADBOT_E2E_VERIFY_FORWARD=1

# Reverse proxy (Traefik)
# План A: один Traefik на сервері, маршрутизація по доменах через labels.
# Для test-стека: TRAEFIK_DOMAIN="test-new-england.morgan-dev.com", TRAEFIK_ROUTER="powerbot-test".
TRAEFIK_RULE="Host(`new-england.morgan-dev.com`) || Host(`sensors-new-england.morgan-dev.com`)"
TRAEFIK_ROUTER="powerbot-prod"
TRAEFIK_CERTRESOLVER="letsencrypt_http"
TRAEFIK_NETWORK="traefik"
# Змінні для самого Traefik контейнера (email/dns provider/api version/CF token) винесені в `traefik/.env.example`
# і не повинні зʼявлятись у `/opt/powerbot/.env`.
#
# Для test-стека:
# TRAEFIK_RULE="Host(`test-new-england.morgan-dev.com`)"
# TRAEFIK_ROUTER="powerbot-test"

# ID адміністраторів (через кому)
ADMIN_IDS="123456789,987654321"

# Тег адміна для зворотного зв'язку
ADMIN_TAG="@YourAdminUsername"

# Координати для погоди (Open-Meteo, без ключа)
WEATHER_LAT="50.4501"
WEATHER_LON="30.5234"
WEATHER_API_URL="https://api.open-meteo.com/v1/forecast"
WEATHER_TIMEZONE="Europe/Kyiv"

# Телефони сервісів
SECURITY_PHONE="+380XXXXXXXXX"
PLUMBER_PHONE="+380XXXXXXXXX"
ELECTRICIAN_PHONE="+380XXXXXXXXX"
ELEVATOR_PHONES="+380XXXXXXXXX,+380XXXXXXXXX"

# API ключі для тривог
ALERTS_API_KEY="your_alerts_api_key_here"
ALERTS_IN_UA_API_KEY="your_alerts_in_ua_api_key_here"
ALERTS_CITY_ID_UKRAINEALARM="31"
ALERTS_CITY_UID_ALERTS_IN_UA="31"
ALERTS_API_URL="https://api.ukrainealarm.com/api/v3"
ALERTS_IN_UA_API_URL="https://api.alerts.in.ua/v1"
# 7 означає: 7 запитів до alerts.in.ua, потім 1 до ukrainealarm (~раз на 88 сек при інтервалі 11 сек)
ALERTS_IN_UA_RATIO=7

# === Yasno planned outages (Kyiv) ===
# У тестовому боті увімкнеться автоматично через deploy_test.sh
YASNO_ENABLED=0
YASNO_REGION_ID=25
YASNO_DSO_ID=902
# Street query може бути заданий у кількох варіантах через `|` (fallback):
#   YASNO_STREET_QUERY_DEFAULT="вул. Максимовича|вул. Максимовича Михайла"
YASNO_STREET_QUERY_DEFAULT="вул. Максимовича|вул. Максимовича Михайла"

# Якщо HOUSE_QUERIES порожній — графіки для будинку не показуються.
# Опціонально: можна задати street query окремо для конкретного будинку (має пріоритет над DEFAULT):
#   YASNO_BUILDING_1_STREET_QUERY="вул. Максимовича|вул. Максимовича Михайла"
# Якщо змінна не задана — буде використано `YASNO_STREET_QUERY_DEFAULT`.
YASNO_BUILDING_1_HOUSE_QUERIES_SEC_1="24В"
YASNO_BUILDING_1_HOUSE_QUERIES_SEC_2="24В"
YASNO_BUILDING_1_HOUSE_QUERIES_SEC_3="24В"

YASNO_BUILDING_2_HOUSE_QUERIES_SEC_1="28Б ввод 1|28Б ввод 2"
YASNO_BUILDING_2_HOUSE_QUERIES_SEC_2="28Б ввод 1|28Б ввод 2"
YASNO_BUILDING_2_HOUSE_QUERIES_SEC_3="28Б ввод 1|28Б ввод 2"

YASNO_BUILDING_3_HOUSE_QUERIES_SEC_1="26 ввод 1|26 ввод 2"
YASNO_BUILDING_3_HOUSE_QUERIES_SEC_2="26 ввод 1|26 ввод 2"
YASNO_BUILDING_3_HOUSE_QUERIES_SEC_3="26 ввод 1|26 ввод 2"

YASNO_BUILDING_4_HOUSE_QUERIES_SEC_1="24А ввод 1|24А ввод 2"
YASNO_BUILDING_4_HOUSE_QUERIES_SEC_2="24А ввод 1|24А ввод 2"
YASNO_BUILDING_4_HOUSE_QUERIES_SEC_3="24А ввод 1|24А ввод 2"

YASNO_BUILDING_5_HOUSE_QUERIES_SEC_1="24-Б ввод 1|24-Б ввод 2"
YASNO_BUILDING_5_HOUSE_QUERIES_SEC_2="24-Б ввод 1|24-Б ввод 2"
YASNO_BUILDING_5_HOUSE_QUERIES_SEC_3="24-Б ввод 1|24-Б ввод 2"

YASNO_BUILDING_6_HOUSE_QUERIES_SEC_1="24В"
YASNO_BUILDING_6_HOUSE_QUERIES_SEC_2="24В"
YASNO_BUILDING_6_HOUSE_QUERIES_SEC_3="24В"

YASNO_BUILDING_7_HOUSE_QUERIES_SEC_1="24В"
YASNO_BUILDING_7_HOUSE_QUERIES_SEC_2="24В"
YASNO_BUILDING_7_HOUSE_QUERIES_SEC_3="24В"

YASNO_BUILDING_8_HOUSE_QUERIES_SEC_1="26Г"
YASNO_BUILDING_8_HOUSE_QUERIES_SEC_2="26Г"
YASNO_BUILDING_8_HOUSE_QUERIES_SEC_3="26Г"

YASNO_BUILDING_9_HOUSE_QUERIES_SEC_1="26В"
YASNO_BUILDING_9_HOUSE_QUERIES_SEC_2="26В"
YASNO_BUILDING_9_HOUSE_QUERIES_SEC_3="26В"

YASNO_BUILDING_10_HOUSE_QUERIES_SEC_1="28Е"
YASNO_BUILDING_10_HOUSE_QUERIES_SEC_2="28Е"
YASNO_BUILDING_10_HOUSE_QUERIES_SEC_3="28Е"

YASNO_BUILDING_11_HOUSE_QUERIES_SEC_1="26В"
YASNO_BUILDING_11_HOUSE_QUERIES_SEC_2="26В"
YASNO_BUILDING_11_HOUSE_QUERIES_SEC_3="26В"

YASNO_BUILDING_12_HOUSE_QUERIES_SEC_1="24В"
YASNO_BUILDING_12_HOUSE_QUERIES_SEC_2="24В"
YASNO_BUILDING_12_HOUSE_QUERIES_SEC_3="24В"

YASNO_BUILDING_13_HOUSE_QUERIES_SEC_1="26В"
YASNO_BUILDING_13_HOUSE_QUERIES_SEC_2="26В"
YASNO_BUILDING_13_HOUSE_QUERIES_SEC_3="26В"

YASNO_BUILDING_14_HOUSE_QUERIES_SEC_1=
YASNO_BUILDING_14_HOUSE_QUERIES_SEC_2=
YASNO_BUILDING_14_HOUSE_QUERIES_SEC_3=

# Параметри масових розсилок (rate limit)
BROADCAST_RATE_PER_SEC=20
BROADCAST_CONCURRENCY=8
BROADCAST_MAX_RETRIES=1
# Мінімальний інтервал для одного мешканця між повідомленнями "Дайджест акцій" (години).
# default: 168 год = не частіше 1 раз на 7 днів.
OFFERS_DIGEST_MIN_INTERVAL_HOURS=168

# ESP32 сенсори
# Всередині контейнера API_PORT=8081. Зовні можна мапити інший порт.
API_PORT=8081
SENSOR_API_KEY="your-64-char-hex-key"
# Read-only key for public sensor status endpoints (for external developers).
# Keep separate from SENSOR_API_KEY (write key for heartbeat).
SENSOR_PUBLIC_API_KEY="your-public-readonly-key"
SENSOR_TIMEOUT_SEC=150
# Optional override for canonical sensor UUID -> building_id mapping.
# Default rollout mapping is built into code (for esp32-*-001 sensors from installation table).
# Use this env only to override/add mappings without code changes.
# Format: SENSOR_UUID_BUILDING_MAP="uuid:building_id,uuid:building_id"
# Example:
# SENSOR_UUID_BUILDING_MAP="esp32-cambridge-001:3,esp32-bristol-001:5"
SENSOR_UUID_BUILDING_MAP=""
SENSORS_DOMAIN="sensors-new-england.morgan-dev.com"

# Sensor aliases (temporary "synonyms" for sections/buildings)
# Use when one physical sensor should represent multiple sections/buildings.
# Format:
#   SENSOR_ALIAS_<SRC_BUILDING_ID>_<SRC_SECTION_ID>="DSTB:DSTS,DSTB:DSTS"
# Example:
#   # Newcastle sec2 signal is treated as if it is also present for sec1, sec3 and Bristol sec3:
#   SENSOR_ALIAS_1_2="1:1,1:3,5:3"

# Шлях до БД (потрібно для Docker з bind-mount)
DB_PATH="/data/state.db"
